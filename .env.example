# ═══════════════════════════════════════════════════════════════
# LuatBot — Environment Variables
# Copy file này thành .env và điền giá trị thật
# ═══════════════════════════════════════════════════════════════

# ─── CẤU HÌNH LOCAL AI "XỊN" (SOTA LOCAL PRESET - KHÔNG CẦN CLOUD KEY) ───
# Bật 1 trong 2 cấu hình dưới đây tuỳ theo cấu hình máy của bạn:

# [Lựa chọn 1: Code & Pháp lý đỉnh cao - Qwen 2.5 Coder 32B Instruct qua AirLLM (Không cần RAM/VRAM lớn)]
# ACTIVE_LLM_PROVIDER=airllm
# AIRLLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# AIRLLM_MAX_LENGTH=4096

# [Lựa chọn 2: Suy luận sâu pháp lý - Qwen 2.5 72B Instruct qua AirLLM]
# ACTIVE_LLM_PROVIDER=airllm
# AIRLLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# AIRLLM_MAX_LENGTH=4096

# [Lựa chọn 3: Phản hồi nhanh - Chạy Ollama Qwen 2.5 Coder 32B / 14B]
# ACTIVE_LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5-coder:32b

# [Cấu hình Local RAG SOTA (Embedding & Reranker Tiếng Việt - Chạy 100% Local)]
# EMBEDDING_MODEL_SOTA=BAAI/bge-m3
# RERANKER_MODEL_SOTA=BAAI/bge-reranker-v2-m3
# VECTOR_DB_SOTA_PATH=vector_store.db
# FAISS_INDEX_SOTA_PATH=chunks_faiss_sq8.index

# ─── FPT Cloud LLM Gateway (Cloud API) ───
FPT_CLOUD_API_KEY=your_fpt_cloud_api_key_here
FPT_CLOUD_DEFAULT_MODEL=DeepSeek-V4-Flash

# ─── Google Gemini (backup Cloud API) ───
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Server ───
HOST=0.0.0.0
PORT=8000

