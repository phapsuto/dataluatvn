# ═══════════════════════════════════════════════════════════════
# LuatBot — Environment Variables
# Copy file này thành .env và điền giá trị thật
# ═══════════════════════════════════════════════════════════════

# ─── FPT Cloud LLM Gateway ───
FPT_CLOUD_API_KEY=your_fpt_cloud_api_key_here
FPT_CLOUD_DEFAULT_MODEL=DeepSeek-V4-Flash

# ─── Google Gemini (backup) ───
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Server ───
HOST=0.0.0.0
PORT=8000
